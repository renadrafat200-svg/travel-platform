# Copy this file to backend/.env and fill in real values. Never commit backend/.env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/travel-platform?retryWrites=true&w=majority&appName=Cluster0
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
# Cookies are httpOnly + Secure + SameSite (ACC-19). Browsers accept Secure cookies on http://localhost.
# Only if a testing tool drops them, set COOKIE_SECURE=false here.
COOKIE_SECURE=true
FRONTEND_URL=http://localhost:3001
# Admin account created automatically on first start (admins cannot register)
ADMIN_EMAIL=admin@travel.local
ADMIN_PASSWORD=ChangeMe123
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FXRATES_API_KEY=

# Optional bonus: email (verification, forgot password, email notifications).
# Leave SMTP_HOST empty to print emails in the terminal instead of sending them.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true, SMTP_USER=your Gmail,
# SMTP_PASS=a Google "App password" (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of this backend used in email links
APP_URL=http://localhost:3000

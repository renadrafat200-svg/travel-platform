
# Optional bonus: email (verification, forgot password, email notifications).
# Leave SMTP_HOST empty to print emails in the terminal instead of sending them.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true, SMTP_USER=your Gmail,
# SMTP_PASS=a Google "App password" (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of this backend used in email links
APP_URL=http://localhost:3000
